// The record type.
class Point {
    var x;
    var y;
    var z;
    def Point() { this.x = 0; this.y = 0; this.z = 0; }
}

def bench(n) {
    var p = Point();
    for (var i = 0; i < n; ++i) {
        p.x = p.x + (i & 7);
        p.y = p.y + (p.x & 3);
        p.z = p.z + (p.y & 1);
    }
    p.x + p.y + p.z;
}
