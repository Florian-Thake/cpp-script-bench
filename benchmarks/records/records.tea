func bench( n ) {
    // The record: a named Tuple.
    def p := _tuple_create()
    def p.x := 0
    def p.y := 0
    def p.z := 0
    forall( i in _seq( 0, n - 1, 1 ) ) {
        p.x := p.x + (i bit_and 7)
        p.y := p.y + (p.x bit_and 3)
        p.z := p.z + (p.y bit_and 1)
    }
    p.x + p.y + p.z
}
