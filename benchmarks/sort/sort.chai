def bench(n) {
    var a = [];
    a.reserve(n);
    var x = 1;
    for (var k = 0; k < n; ++k) {
        x = (x * 75 + 74) % 65537;
        a.push_back(x);
    }
    for (var i = 1; i < n; ++i) {
        var v = a[i];
        var j = i - 1;
        while (j >= 0 && a[j] > v) {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = v;
    }
    var sum = 0;
    for (var i = 0; i < n; ++i) {
        sum = sum + a[i] * (i & 7);
    }
    sum;
}
