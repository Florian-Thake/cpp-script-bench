func bench( n ) {
    def sum := 0
    forall( i in _seq( 0, n - 1, 1 ) ) {
        const k := i bit_and 7
        if( k == 0 ) {
            sum := sum + 1
        } else if( k == 1 ) {
            sum := sum + 2
        } else if( k < 4 ) {
            sum := sum + 3
        } else {
            sum := sum + 4
        }
        if( (k > 2 and k < 6) or k == 7 ) {
            sum := sum + 5
        }
    }
    sum
}
