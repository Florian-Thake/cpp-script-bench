def bench(n) {
    var sum = 0;
    for (var i = 0; i < n; ++i) {
        var k = i & 7;
        if (k == 0) {
            sum = sum + 1;
        } else if (k == 1) {
            sum = sum + 2;
        } else if (k < 4) {
            sum = sum + 3;
        } else {
            sum = sum + 4;
        }
        if ((k > 2 && k < 6) || k == 7) {
            sum = sum + 5;
        }
    }
    sum;
}
