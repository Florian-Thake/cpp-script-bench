def bench(n) {
    var total = 0;
    for (var s = 1; s <= n; ++s) {
        var x = s;
        while (x != 1) {
            if (x % 2 == 0) {
                x = x / 2;
            } else {
                x = 3 * x + 1;
            }
            total = total + 1;
        }
    }
    total;
}
