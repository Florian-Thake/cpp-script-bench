// No 'return': ChaiScript implements it with a C++ exception, unless it is the last statement
// of a function. The value of the last expression is the return value.
def fib(x) {
    if (x < 2) {
        x;
    } else {
        fib(x - 1) + fib(x - 2);
    }
}

def bench(n) {
    fib(n);
}
