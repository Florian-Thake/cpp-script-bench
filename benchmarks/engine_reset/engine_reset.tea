// The script of engine_reset: a top-level variable and two functions. The runner loads it, resets
// the engine and loads it again (see README.md).
// TeaScript rejects a redefinition, so a reset which kept the old definitions would fail.

def offset := 3

func f1( a ) {
    a bit_and 7
}

func bench( n ) {
    def sum := offset
    forall( i in _seq( 0, n - 1, 1 ) ) {
        sum := sum + f1( i )
    }
    sum
}
