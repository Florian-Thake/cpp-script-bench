func tak( x, y, z ) {
    if( y < x ) {
        tak( tak( x - 1, y, z ), tak( y - 1, z, x ), tak( z - 1, x, y ) )
    } else {
        z
    }
}

func bench( n ) {
    tak( 3 * n, 2 * n, n )
}
