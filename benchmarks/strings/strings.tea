func bench( n ) {
    def sum := 0
    def prev := ""
    forall( i in _seq( 0, n - 1, 1 ) ) {
        const s := "item" % i
        if( s < prev ) {
            sum := sum + 1
        }
        sum := sum + _strlen( s )
        const d := _substr( s, 4, -1 )
        sum := sum + ((d as i64) bit_and 7)
        prev := s
    }
    sum
}
