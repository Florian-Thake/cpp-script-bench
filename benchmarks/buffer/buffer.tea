// image is a Buffer of the host with n * n pixels of 4 bytes, all 0. The pixel value is a u64, the type
// which _buf_set_u32 takes: an operation with a u64 operand gives a u64, so no cast is needed.
func bench( n ) {
    forall( y in _seq( 0, n - 1, 1 ) ) {
        forall( x in _seq( 0, n - 1, 1 ) ) {
            _buf_set_u32( image, (y * n + x) * 4, (x bit_and 255u64) + (y bit_and 255u64) * 256u64 + ((x + y) bit_and 255u64) * 65536u64 )
        }
    }
    n * n
}
