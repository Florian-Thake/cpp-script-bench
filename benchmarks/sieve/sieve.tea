func bench( n ) {
    def flags := _tuple_create()
    _tuple_reserve( flags, n + 1 )
    forall( k in _seq( 0, n, 1 ) ) {
        _tuple_append( flags, true )
    }
    def i := 2
    repeat {
        if( i * i > n ) { stop }
        if( flags[i] ) {
            forall( j in _seq( i * i, n, i ) ) {
                flags[j] := false
            }
        }
        i := i + 1
    }
    def count := 0
    forall( k in _seq( 2, n, 1 ) ) {
        if( flags[k] ) {
            count := count + 1
        }
    }
    count
}
