func bench( n ) {
    def sum := 0
    forall( a in _seq( 0, n - 1, 1 ) ) {
        forall( b in _seq( 0, n - 1, 1 ) ) {
            forall( c in _seq( 0, n - 1, 1 ) ) {
                forall( d in _seq( 0, n - 1, 1 ) ) {
                    sum := sum + ((a + b + c + d) bit_and 7)
                }
            }
        }
    }
    sum
}
