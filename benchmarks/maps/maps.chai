def bench(n) {
    var keys = [];
    keys.reserve(n);
    for (var i = 0; i < n; ++i) {
        keys.push_back("k" + to_string(i));
    }
    var m = Map();
    for (var i = 0; i < n; ++i) {
        m[keys[i]] = i;
    }
    var sum = 0;
    for (var i = 0; i < n; ++i) {
        sum = sum + m[keys[i]];
    }
    for (var i = 0; i < n; i = i + 2) {
        m.erase(keys[i]);
    }
    for (var i = 0; i < n; ++i) {
        if (m.count(keys[i]) > 0) {
            sum = sum + 1;
        }
    }
    sum;
}
