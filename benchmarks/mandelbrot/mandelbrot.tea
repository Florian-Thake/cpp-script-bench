func bench( n ) {
    const max_iter := 50
    def count := 0
    forall( y in _seq( 0, n - 1, 1 ) ) {
        const ci := -1.25 + 2.5 * y / n
        forall( x in _seq( 0, n - 1, 1 ) ) {
            const cr := -2.0 + 2.5 * x / n
            def zr := 0.0
            def zi := 0.0
            def k  := 0
            repeat {
                if( k >= max_iter or zr * zr + zi * zi > 4.0 ) { stop }
                const t := zr * zr - zi * zi + cr
                zi := 2.0 * zr * zi + ci
                zr := t
                k  := k + 1
            }
            count := count + k
        }
    }
    count
}
