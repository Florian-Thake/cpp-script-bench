# Script mode, run by csb_target_git_version() (CsbGitInfo.cmake) on every build:
#   cmake -DGIT_EXECUTABLE=<git> -DCSB_GIT_DIR=<dir> -DCSB_GIT_MACRO=<macro> -DCSB_GIT_HEADER=<file> -P CsbGitVersionHeader.cmake
# Writes <file> with '#define <macro> "<git describe of dir>"', but only if its content changes, so that nothing is
# recompiled when the version stays the same.

include( "${CMAKE_CURRENT_LIST_DIR}/CsbGitInfo.cmake" )

csb_git_describe( "${CSB_GIT_DIR}" version )
set( content "// Generated by CsbGitVersionHeader.cmake on every build.\n#pragma once\n#define ${CSB_GIT_MACRO} \"${version}\"\n" )

set( old "" )
if( EXISTS "${CSB_GIT_HEADER}" )
    file( READ "${CSB_GIT_HEADER}" old )
endif()
if( NOT old STREQUAL content )
    file( WRITE "${CSB_GIT_HEADER}" "${content}" )
endif()
